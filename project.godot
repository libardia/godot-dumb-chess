; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="dumb-chess"
run/main_scene="uid://dr4psr1xll6yx"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

InputDetector="*uid://c2qsh6370ql0"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://addons/commons": 1
}
gdscript/warnings/untyped_declaration=1

[display]

window/stretch/aspect="expand"

[dotnet]

project/assembly_name="dumb-chess"

[editor_plugins]

enabled=PackedStringArray("res://addons/commons/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[svgsprite]

compress=false
